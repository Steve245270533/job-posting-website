model Job {
  id           String        @id @default(cuid())
  title        String
  company      String
  location     String
  type         String
  description  String        @db.Text
  salary       String?
  postedAt     DateTime      @default(now())
  postedById   String
  postedBy     User          @relation("PostedJobs", fields: [postedById], references: [id])
  applications Application[]
}
